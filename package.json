{
  "name": "intent-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Intent Protocol — Verifiable Outcome Infrastructure. Human wants. AI acts. Proof verifies. Blockchain settles.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf packages/*/dist packages/adapters/*/dist workers/*/dist apps/*/dist"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "~5.9.3",
    "vitest": "~3.2.4"
  }
}
